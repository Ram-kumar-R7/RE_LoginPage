<mvc:View
    controllerName="loginpage.controller.Register"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core">

    <Page
        title="Customer Creation"
        showNavButton="true"
        navButtonPress=".onBack">

        <content>
        <HBox
        width="100%"
        justifyContent="Center"
        alignItems="Start"
        class="sapUiLargeMargin">

        <!-- Left Side - Carousel -->
        <Carousel width="730px" height="700px" loop="true"
            class="sapUiMediumMarginEnd" >

            <Image
                src="images/re1.jpg"
                width="100%"
                height="100%"/>

            <Image
                src="images/re2.jpg"
                width="100%"
                height="100%"/>

            <Image
                src="images/re3.jpg"
                width="100%"
                height="100%"/>
            <Image
                src="images/re4.jpg"
                width="100%"
                height="100%"/>
            <Image
                src="images/re5.jpg"
                width="100%"
                height="100%"/>

        </Carousel>

                <Panel
                    width="450px"
                    headerText="SETUP NEW ACCOUNT">

                    <f:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout">

                        <Label text="First Name" required="true" />
                        <Input
                            id="firstName"
                            placeholder="Enter First Name" />

                        <Label text="Last Name" required="true"/>
                        <Input
                            id="lastName"
                            placeholder="Enter Last Name"/>

                        <Label text="Email" required="true"/>
                        <Input
                            id="email"
                            type="Email"
                            placeholder="Enter Email"/>

                        <Label text="Mobile Number" required="true"/>
                        <Input
                            id="mobile"
                            type="Tel"
                            placeholder="Enter Mobile Number"/>

                        <Label text="Date of Birth" required="true"/>
                        <DatePicker
                            id="dob"
                            width="100%"
                            placeholder="Select Date"/>

                        <Label text="Gender" required="true"/>
                        <Select id="gender">
                            <items>
                                <core:Item  text="Male"/>
                                <core:Item  text="Female"/>
                            </items>
                        </Select>

                        <Label text="Username" required="true"/>
                        <Input
                            id="registerUsername"
                            placeholder="Enter Username"/>

                        <Label text="Password" required="true"/>
                        <Input
                            id="registerPassword"
                            type="Password"
                            placeholder="Enter Password"/>

                        <Label text="Confirm Password" required="true"/>
                        <Input
                            id="confirmPassword"
                            type="Password"
                            placeholder="Confirm Password"/>

                    </f:SimpleForm>

                    <Button
                        text="Create Account"
                        type="Emphasized"
                        width="80%"
                        press=".onCreate"
                        class="sapUiMediumMargin"/>

                </Panel>
</HBox>
            

        </content>

    </Page>

</mvc:View>
