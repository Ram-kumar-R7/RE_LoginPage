         <Page title="Royal Enfield ❯❯❯❯">

    <content>

        <VBox
            justifyContent="Center"
            alignItems="Center"
            height="100%">

            <Panel width="380px">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Welcome Back"/>
                    </Toolbar>
                </headerToolbar>

                <content>

                    <VBox class="sapUiMediumMargin">
                    
                        <Input
                            id="loginusername"
                            placeholder="Username"/>

                        <Input
                            id="loginpassword"
                            type="Password"
                            placeholder="Password"
                            class="sapUiSmallMarginTop"/>

                        <Button
                            text="Login"
                            type="Emphasized"
                            width="100%"
                            press=".onLogin"
                            class="sapUiMediumMarginTop"/>

                        <Link
                            text="New User? Register"
                            press=".onRegister"
                            class="sapUiSmallMarginTop"/>

                    </VBox>

                </content>

            </Panel>

        </VBox>

    </content>

</Page> 

